{
  "name": "vault-acl-simu",
  "private": true,
  "version": "1.0.0",
  "description": "regex101-style simulator and generator for HashiCorp Vault ACL policies",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:portable": "tsc && vite build --outDir dist-portable",
    "package:release": "node scripts/package-release.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
